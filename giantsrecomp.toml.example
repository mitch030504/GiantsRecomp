# Copy next to giantsrecompiled.exe, rename to "giantsrecomp.toml". Full docs in README.md.
# The in-game Settings overlay (F4) reads and writes this same file.

["Portal"]
portal_mode = "software"                  # "software", "usb" (real portal), or "none"
portal_figures_dir = ""                   # empty = "figures" next to your saves
# portal_figure = "C:\\path\\to\\Skylander.dump"  # loads this dump onto the portal at startup
portal_ipc = true                         # serve the Omoio/Cemu-compatible portal IPC on 127.0.0.1
# portal_ipc_port = 28014                 # TCP port for the portal IPC server

["Graphics"]
resolution = "1920x1080"                  # startup window size: a preset ("720p".."4k"), a custom
                                           # "WxH", or "native" = the monitor's current mode; larger
                                           # than the display is scaled down to fit (never upscaled)
resolution_scale = 2                      # 1-8 supersample multiplier, 1 = off
frame_rate_limit = 60                     # -1 = unlimited, 0 = 30 Hz safe default, N > 0 = cap at N
                                           # (clamped to the display refresh rate)
gpu_allow_invalid_fetch_constants = true  # works around a GPU quirk, on by default
ultrawide_fov = true                      # widen camera FOV to match resolution's aspect ratio
ultrawide_hud = true                      # lay out the HUD and menus for the real screen width
# vulkan_device = -1                      # GPU index for multi-GPU systems, -1 = auto-pick

["GPU"]
# gpu_backend = "auto"                    # "auto" (D3D12 on Windows), "d3d12" or "vulkan"; Linux has
                                           # Vulkan only. Changing it in F4 offers "Restart now"
anisotropic_override = 5                  # texture filtering: 5 = 16x, 3 = 4x, 0 = off
# dlss5_amd = false                      # Linux/AMD: native DLSS 5 NR before HUD (experimental;
                                           # needs the model and shaders under dlss5_amd_data_path)
# dlss5_amd_data_path = ""               # folder that contains dlssnr-amd/ (the parent, not the
                                           # folder itself); empty = next to the executable
# dlss5_amd_mode = 0                     # dev seam gate: 0 = off, 1/2 = substitute a precomputed
                                           # 1920x1080 image (needs dlss5_amd_image), 3 = live
                                           # per-frame NR at the composition seam (enables
                                           # motion_guide automatically), 4 = live per-frame FSR 4
                                           # pre-upscale there (needs fsr4=true and present_effect
                                           # != fsr3); see docs/upscaling.md
# fsr4 = false                           # Linux/AMD: FSR 4.1.2 via a user-built amd_fidelityfx_upscaler_vk.so
                                           # (from your own FidelityFX SDK v2.4.0 DLL; never shipped)
# fsr4_data_path = ""                    # folder with that .so (and its fsr4-assets/); empty = next
#                                        # to the executable. The .so and assets are never packaged.

["UI"]
# ui_scale = 1.5                          # ImGui overlay font/widget scale

["UI/Presenter"]
present_use_actual_aspect = true          # present the real rendered frame at 'resolution's real
                                           # aspect instead of the reported video mode's -- matters
                                           # together with ultrawide_fov above

["Input"]
mnk_mode = true                           # enable keyboard/mouse controller emulation

["Game"]
skip_intro = true                         # skip the Activision and Toys for Bob logo movies

["Runtime"]
# user_data_root = "C:\\path\\to\\folder" # empty = Documents\giantsrecomp

# Experimental netplay (start both games from launch; see docs/netplay.md).
# netplay_host = true
# netplay_port = 24872
# netplay_connect = "192.168.1.10:24872"
# netplay_delay = 3 # Host-selected controller-read delay, normally ~60 reads/s.
#
# Self-hosted relay (NAT traversal): the host creates a room, the client joins by code.
# Run your own server (see server/ and docs/netplay.md), then put its host:port here.
# Candidates are tried in order, LAN first and then the external address. This public
# template ships no relay address: an empty netplay_lobby keeps relay netplay off, and
# direct-IP sessions work unchanged. Set netplay_relay = "off" to force direct mode even
# after filling in a lobby.
netplay_relay = "auto"
netplay_lobby = ""
# netplay_room = "A1B2C3D4" # Client only.
