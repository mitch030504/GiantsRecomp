# Copy to .env and fill in GIANTS_PUBLIC_IP before `docker compose up -d`.
# The server refuses to start without a public IPv4: advertising the Docker
# bridge address would hand players an unroutable endpoint.

# REQUIRED: the public IPv4 players send UDP to (your router's WAN address
# when UDP 32200 and UDP 41100-41199 are forwarded to this host).
GIANTS_PUBLIC_IP=

# Optional: the IPv4 put into JOIN_ACK. Defaults to GIANTS_PUBLIC_IP. Set it to
# the relay host's LAN IP (e.g. 192.168.8.2) for LAN testing before the router
# port forwards exist.
GIANTS_ADVERTISE_IP=

# Control/lobby socket.
GIANTS_CONTROL_PORT=32200

# One UDP socket per room; the range size is the hard room capacity.
GIANTS_RELAY_MIN=41100
GIANTS_RELAY_MAX=41199

# Room idle lifetime in seconds, refreshed by KEEPALIVE and relayed traffic.
GIANTS_TTL=30

# Room-table cap; cannot exceed the relay port range.
GIANTS_MAX_SESSIONS=100

# Control-socket rate limit per source IP. Relay sockets use 4x these values.
GIANTS_RATE_PER_SECOND=50
GIANTS_RATE_BURST=100

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs are one JSON object per line.
GIANTS_LOG_LEVEL=INFO
